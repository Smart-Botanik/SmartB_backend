NODE_ENV=development
PORT=3001
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
# grow_db — root docker-compose.dev.yml `growdb` (:5433 / grow_dev)
DATABASE_URL=postgresql://growing:growing@localhost:5433/grow_dev?schema=public

# ADR-0023 auth-service (identity / tokens / roles). JWT_ACCESS_SECRET must match auth-service.
AUTH_CUTOVER=true
AUTH_SERVICE_URL=http://localhost:3018
AUTH_SERVICE_INTERNAL_KEY=dev-auth-internal
AUTH_DATABASE_URL=postgresql://growing:growing@localhost:5442/auth_dev

# ADR-0024 user-service (profile SoT)
USER_SERVICE_URL=http://localhost:3019
USER_SERVICE_INTERNAL_KEY=dev-user-internal
USER_DATABASE_URL=postgresql://growing:growing@localhost:5443/user_dev

# Microservices (BK-MS-TAX-3 / BK-MS-REFDATA-3 cutover)
TAXONOMY_CUTOVER=true
TAXONOMY_SERVICE_URL=http://localhost:3010
TAXONOMY_SERVICE_INTERNAL_KEY=dev-taxonomy-internal
TAXONOMY_DATABASE_URL=postgresql://growing:growing@localhost:5436/taxonomy_dev
# BK-MS-REFDATA-3 cutover (required for Brand/Product GraphQL on monolith)
REFERENCE_DATA_CUTOVER=true
REFERENCE_DATA_SERVICE_URL=http://localhost:3011
REFERENCE_DATA_SERVICE_INTERNAL_KEY=dev-reference-data-internal
REFERENCE_DATA_DATABASE_URL=postgresql://growing:growing@localhost:5435/reference_data_dev

# BK-MS-CONTENT-3 cutover (Guide / SitePage / Telegram → content-service)
CONTENT_CUTOVER=true
CONTENT_SERVICE_URL=http://localhost:3012
CONTENT_SERVICE_INTERNAL_KEY=dev-content-internal
CONTENT_DATABASE_URL=postgresql://growing:growing@localhost:5437/content_dev

# BK-MS-MEDIA-2 cutover (Media → media-service)
MEDIA_CUTOVER=true
MEDIA_SERVICE_URL=http://localhost:3016
MEDIA_SERVICE_INTERNAL_KEY=dev-media-internal
MEDIA_DATABASE_URL=postgresql://growing:growing@localhost:5439/media_dev

# BK-MS-EDGES cutover (ContentFacet* → content-edges)
CONTENT_EDGES_CUTOVER=true
CONTENT_EDGES_SERVICE_URL=http://localhost:3013
CONTENT_EDGES_SERVICE_INTERNAL_KEY=dev-content-edges-internal
CONTENT_EDGES_DATABASE_URL=postgresql://growing:growing@localhost:5438/content_edges_dev

# ADR-0022 AI content service (lunar facts + generation drafts)
AI_SERVICE_URL=http://localhost:3017
AI_SERVICE_INTERNAL_KEY=dev-ai-internal
AI_DATABASE_URL=postgresql://growing:growing@localhost:5441/ai_dev

# Local Storage Configuration
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3001
