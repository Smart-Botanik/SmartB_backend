{
  "name": "backend_nest",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:registry": "ts-node src/scripts/seed-action-path-registry.ts",
    "db:seed:registry:fieldspec": "ts-node src/scripts/seed-registry-field-specs.ts",
    "db:seed:registry:mvp": "set REGISTRY_SEED_SCOPE=mvp&& ts-node src/scripts/seed-action-path-registry.ts",
    "db:seed:registry:full": "set REGISTRY_SEED_SCOPE=full&& ts-node src/scripts/seed-action-path-registry.ts",
    "export:registry-manifest": "ts-node src/scripts/export-registry-manifest.ts",
    "verify:plant-replay": "ts-node src/scripts/verify-plant-replay.ts",
    "test:plant-replay:determinism": "ts-node src/scripts/test-plant-replay-determinism.ts",
    "test:plant-replay:time-boundary": "ts-node src/scripts/test-plant-replay-time-boundary.ts",
    "test:registry-profile:e2e": "ts-node src/scripts/test-registry-profile-e2e.ts",
    "test:registry-plant-created:e2e": "ts-node src/scripts/test-registry-plant-created-e2e.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@growing/content-markdown": "file:../packages/content-markdown",
    "@growing/contracts": "file:../packages/contracts",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "apollo-server-express": "^3.13.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^4.6.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/swagger-ui-express": "^4.1.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
