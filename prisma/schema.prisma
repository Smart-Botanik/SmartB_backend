generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Срез схемы (фиксация после выходных, 2026-04-13)
// - Role: только USER | ADMIN (совпадает с JWT/контрактами; при расхождении с БД — отдельная миграция enum).
// - Location: владелец userId, статусы/типы Strapi-совместимые, specs (блоки lighting,
//   enclosure, space, area), связи Plant.locationId и M2M Diary↔Location.
// - CultivationUnit (ADR-0011): среда выращивания; Location — контейнер + parentLocationId.
// - Подробности: memory/locations/main.md, ADR-0011.
// =============================================================================

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plants            Plant[]
  plantGroups       PlantGroup[]
  diaries           Diary[]
  locations         Location[]
  cultivationUnits  CultivationUnit[]
}

enum PlantGroupStatus {
  active
  cancelled
}

enum PlantPlacementStage {
  none
  planned
  ready_to_plant
  seated
}

/// Организационная группа растений (когорта). Удаление запрещено — только `cancelled`.
model PlantGroup {
  id        String             @id @default(cuid())
  userId    String
  name      String
  diaryId   String?
  status    PlantGroupStatus   @default(active)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  diary  Diary?  @relation(fields: [diaryId], references: [id], onDelete: SetNull)
  plants Plant[]

  @@index([userId])
  @@index([diaryId])
}

model Plant {
  id                            String              @id @default(cuid())
  userId                        String
  diaryId                       String?
  locationId                    String?
  cultivationUnitId             String?
  cultivationUnitNudgeDismissed Boolean             @default(false)
  groupId                       String?
  name                          String
  summarize                     String?             @default("")
  current                       Json?
  placementStage                PlantPlacementStage @default(none)
  plannedLocationId             String?
  currentSeatId                 String?             @unique
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  diary             Diary?            @relation(fields: [diaryId], references: [id], onDelete: SetNull)
  location          Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  plannedLocation   Location?         @relation("PlantPlannedLocation", fields: [plannedLocationId], references: [id], onDelete: SetNull)
  cultivationUnit   CultivationUnit?  @relation(fields: [cultivationUnitId], references: [id], onDelete: SetNull)
  group             PlantGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  currentSeat       Seat?             @relation("PlantCurrentSeat", fields: [currentSeatId], references: [id], onDelete: SetNull)
  seat              Seat?             @relation("SeatOccupant")

  @@index([userId])
  @@index([diaryId])
  @@index([locationId])
  @@index([plannedLocationId])
  @@index([cultivationUnitId])
  @@index([groupId])
  @@index([placementStage])
}

model Event {
  id         String   @id @default(cuid())
  actionPath String
  targetType String
  targetId   String
  payload    Json
  registryVersion     String?
  registrySnapshot    Json?
  payloadSchemaVersion String?
  handlerVersion      String?
  timestamp  DateTime @default(now())
  isSystem   Boolean  @default(false)

  @@index([targetType, targetId, timestamp])
  @@index([actionPath])
}

model PlantProjectionCheckpoint {
  id        String   @id @default(cuid())
  plantId   String
  eventId   String   @unique
  createdAt DateTime @default(now())

  @@index([plantId, createdAt])
}

model PlantSnapshot {
  id               String   @id @default(cuid())
  plantId          String
  asOfEventId      String?
  asOfTimestamp    DateTime
  projectorVersion String
  state            Json
  createdAt        DateTime @default(now())

  @@index([plantId, asOfTimestamp])
}

model Tag {
  id         String   @id @default(cuid())
  label      String   @unique
  targetType String?
  color      String?
  icon       String?
  category   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  actionPathRegistries ActionPathRegistry[]

  @@index([category])
  @@index([targetType])
  @@index([label])
}

model ActionPathRegistry {
  id           String   @id @default(cuid())
  actionPath   String   @unique
  description  String?  @default("")
  targetType   String
  mapping      Json
  conditions   Json?
  autoTagRules Json?
  schema       Json?
  tagId        String?
  groupId      String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tag   Tag?                     @relation(fields: [tagId], references: [id], onDelete: SetNull)
  group ActionPathRegistryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([targetType])
  @@index([tagId])
  @@index([groupId, position])
}

model ActionPathRegistryGroup {
  id          String   @id @default(cuid())
  path        String   @unique
  description String?  @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registries ActionPathRegistry[]

  @@index([path])
}

enum PrimitiveValueType {
  number
  string
  boolean
  json
}

enum PrimitiveStatus {
  active
  deprecated
}

enum RegistryValueType {
  number
  string
  boolean
  date
  enum
  json
}

enum RegistrySemanticKind {
  generic
  ph
  ppm
  temperature
  length
  concentration
}

enum RegistryProfileKind {
  event_write
  timeseries_read
  snapshot_build
}

enum RegistryFieldSpecStatus {
  active
  deprecated
}

model Primitive {
  id         String             @id @default(cuid())
  key        String             @unique
  name       String
  valueType  PrimitiveValueType
  unit       String?
  validation Json?
  status     PrimitiveStatus    @default(active)
  version    Int                @default(1)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
  @@index([key])
}

model RegistryFieldPattern {
  id               String               @id @default(cuid())
  key              String               @unique
  title            String
  valueType        RegistryValueType
  semanticKind     RegistrySemanticKind @default(generic)
  canonicalUnit    String?
  allowedUnitsJson Json?
  defaultInputUnit String?
  conversionProfile String?
  formatJson       Json?
  constraintsJson  Json?
  isActive         Boolean              @default(true)
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  fieldSpecs RegistryFieldSpec[]

  @@index([isActive])
  @@index([key])
}

/// Contract field catalog for Projection/Stream Registry v1 (canonical paths only).
model RegistryFieldSpec {
  id               String                  @id @default(cuid())
  fieldId          String                  @unique
  entity           String
  label            String
  valueType        RegistryValueType
  semanticKind     RegistrySemanticKind    @default(generic)
  unit             String?
  canonicalPath    String
  required         Boolean                 @default(false)
  formatJson       Json?
  constraintsJson  Json?
  fieldPatternId   String?
  includeInCurrent Boolean                 @default(false)
  status           RegistryFieldSpecStatus @default(active)
  version          Int                     @default(1)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  profileFields RegistryProfileField[]
  fieldPattern  RegistryFieldPattern? @relation(fields: [fieldPatternId], references: [id], onDelete: SetNull)

  @@index([entity, status])
  @@index([fieldId])
  @@index([fieldPatternId])
}

/// Named set of selected fields for scenario-specific projection/stream usage.
model RegistryProfile {
  id          String              @id @default(cuid())
  key         String              @unique
  entity      String
  kind        RegistryProfileKind
  title       String
  description String?
  version     Int                 @default(1)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  fields RegistryProfileField[]

  @@index([entity, kind, isActive])
}

/// Field membership within a profile (ordered + required flag).
model RegistryProfileField {
  id          String  @id @default(cuid())
  profileId   String
  fieldSpecId String
  position    Int     @default(0)
  required    Boolean @default(false)

  profile   RegistryProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fieldSpec RegistryFieldSpec @relation(fields: [fieldSpecId], references: [id], onDelete: Restrict)

  @@unique([profileId, fieldSpecId])
  @@index([profileId, position])
}

model Diary {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  body      String
  summarize String?  @default("")
  current   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plants            Plant[]
  plantGroups       PlantGroup[]
  locations         Location[]        @relation("DiaryLocations")
  cultivationUnits  CultivationUnit[] @relation("DiaryCultivationUnits")

  @@index([userId])
}

model DiaryProjectionCheckpoint {
  id        String   @id @default(cuid())
  diaryId   String
  eventId   String   @unique
  createdAt DateTime @default(now())

  @@index([diaryId, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  provider  String
  bucket    String
  key       String
  url       String
  mime      String?
  size      Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  guideCovers      CropGuide[] @relation("GuideCover")

  @@index([provider])
  @@index([bucket])
}

/// M2M CropGuide ↔ taxonomy tag id (tag rows live in taxonomy-service). BK-MS-TAX-3
model CropGuideTaxonomyTag {
  cropGuideId   String
  taxonomyTagId String

  cropGuide CropGuide @relation(fields: [cropGuideId], references: [id], onDelete: Cascade)

  @@id([cropGuideId, taxonomyTagId])
  @@index([taxonomyTagId])
}

// --- Location (ex Strapi api::location) ------------------------------------

enum LocationStatus {
  active
  archived
}

/// indoor | outdoor | greenhouse — задаёт семейство subType
enum LocationType {
  indoor
  outdoor
  greenhouse
}

/// Бывший Strapi `sub_type`; префикс должен соответствовать `type` (проверка на уровне приложения)
enum LocationSubType {
  indoor_growbox
  indoor_cabinet
  indoor_pc_case
  indoor_shelf
  indoor_room
  outdoor_bed
  outdoor_soil
  outdoor_pot
  greenhouse_classic
  greenhouse_tunnel
}

enum LocationWateringType {
  manual
  drip
  hydroponics
  aeroponics
}

/// Дискриминант для блоков бывшего dynamic zone `specs`
enum LocationSpecKind {
  lighting
  enclosure
  space
  area
}

// --- ADR-0013 Location unification (REW-01) --------------------------------

/// How planting places are modeled on a Location (Seat entity — REW-02).
enum SeatLayoutMode {
  fixed_grid
  unlimited
  simple_counter
}

model Location {
  id               String                @id @default(cuid())
  userId           String
  parentLocationId String?
  name             String
  status           LocationStatus        @default(active)
  current          Json?
  /// Transitional bridge (ADR-0011 legacy). Sunset REW-03 — map to `environmentTagId`, then drop.
  type             LocationType?
  /// Transitional bridge (ADR-0011 legacy). Sunset REW-03 — map to `environmentTagId`, then drop.
  subType          LocationSubType?
  wateringType     LocationWateringType?
  description      String?
  /// @deprecated REW-01-3 — use `seatLayoutMode` + Seat / `occupiedCount`
  capacity         Int?
  /// @deprecated REW-01-3 — use `occupiedCount`
  occupiedSlots    Int?
  /// Mandatory SoT (ADR-0013 §6): leaf `ENVIRONMENT_VARIANT`, scope `environment` (ADR-0012).
  environmentTagId String?
  /// Denormalized `indoor`|`outdoor`|`greenhouse` for SQL filters; derived from taxonomy parent on write.
  environmentGroupSlug String?
  /// Optional cm hints: { "width"?, "depth"?, "height"?, "unit"?: "cm" }
  dimensions       Json?
  seatLayoutMode   SeatLayoutMode        @default(simple_counter)
  /// Grid hints v1: { "gridCols"?, "gridRows"?, "cellWidthCm"?, "cellDepthCm"? }
  layoutMeta       Json?
  /// Aggregate occupied places; derived from Seat/plants in app layer
  occupiedCount    Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                    Location?                  @relation("LocationTree", fields: [parentLocationId], references: [id], onDelete: SetNull)
  children                  Location[]                 @relation("LocationTree")
  plants                    Plant[]
  plannedPlants             Plant[]                    @relation("PlantPlannedLocation")
  diaries                   Diary[]                    @relation("DiaryLocations")
  specBlocks                LocationSpecBlock[]
  taxonomyTags              LocationTaxonomyTag[]
  primaryCultivationUnits   CultivationUnit[]          @relation("CultivationUnitPrimaryLocation")
  cultivationUnitPlacements CultivationUnitPlacement[]
  seats                     Seat[]

  @@index([userId])
  @@index([userId, status])
  @@index([parentLocationId])
  @@index([environmentTagId])
  @@index([environmentGroupSlug])
}

/// M2M Location ↔ taxonomy tag id (tags live in taxonomy-service). ADR-0013
model LocationTaxonomyTag {
  locationId    String
  taxonomyTagId String

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([locationId, taxonomyTagId])
  @@index([taxonomyTagId])
}

// --- REW-02 Seat --------------------------------------------------------------

enum SeatStatus {
  active
  archived
}

model Seat {
  id         String     @id @default(cuid())
  locationId String
  label      String
  width      Float?
  depth      Float?
  height     Float?
  /// JSON { row, col } for fixed_grid layout
  position   Json?
  status     SeatStatus @default(active)
  /// Set when plant is seated (REW-06); nullable until placement API
  plantId    String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  location     Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  plant        Plant?            @relation("SeatOccupant", fields: [plantId], references: [id], onDelete: SetNull)
  currentPlant Plant?            @relation("PlantCurrentSeat")
  taxonomyTags SeatTaxonomyTag[]

  @@unique([locationId, label])
  @@index([locationId, status])
}

model SeatTaxonomyTag {
  seatId        String
  taxonomyTagId String

  seat Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@id([seatId, taxonomyTagId])
  @@index([taxonomyTagId])
}

model LocationProjectionCheckpoint {
  id         String   @id @default(cuid())
  locationId String
  eventId    String   @unique
  createdAt  DateTime @default(now())

  @@index([locationId, createdAt])
}

model LocationSnapshot {
  id               String   @id @default(cuid())
  locationId       String
  asOfEventId      String?
  asOfTimestamp    DateTime
  projectorVersion String
  state            Json
  createdAt        DateTime @default(now())

  @@index([locationId, asOfTimestamp])
}

/// Упорядоченный список блоков specs (аналог Strapi dynamic zone)
model LocationSpecBlock {
  id         String           @id @default(cuid())
  locationId String
  position   Int
  kind       LocationSpecKind

  location  Location                @relation(fields: [locationId], references: [id], onDelete: Cascade)
  lighting  LocationSpecsLighting?
  enclosure LocationSpecsEnclosure?
  space     LocationSpecsSpace?
  area      LocationSpecsArea?

  @@unique([locationId, position])
  @@index([locationId])
}

/// location-specs.lighting — лампы как JSON (массивы IEquipmentLamp-подобных объектов)
model LocationSpecsLighting {
  specBlockId     String @id
  vegetationLamps Json?
  bloomLamps      Json?

  specBlock LocationSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}

/// location-specs.enclosure
model LocationSpecsEnclosure {
  specBlockId String  @id
  productId   String?
  width       Float?
  height      Float?
  depth       Float?

  specBlock LocationSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// location-specs.space
model LocationSpecsSpace {
  specBlockId String @id
  width       Float?
  height      Float?
  depth       Float?

  specBlock LocationSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}

/// location-specs.area
model LocationSpecsArea {
  specBlockId String @id
  width       Float?
  depth       Float?

  specBlock LocationSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}

// --- CultivationUnit (ADR-0011) --------------------------------------------

enum CultivationUnitStatus {
  active
  archived
}

enum CultivationUnitPlacementRole {
  primary
  member
  shared
}

/// Среда выращивания: тип, слоты, оборудование. UI — «Окружение».
model CultivationUnit {
  id                String                 @id @default(cuid())
  userId            String
  primaryLocationId String?
  name              String
  status            CultivationUnitStatus  @default(active)
  current           Json?
  type              LocationType?
  subType           LocationSubType?
  capacity          Int?
  occupiedSlots     Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryLocation Location?                  @relation("CultivationUnitPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: Restrict)
  placements      CultivationUnitPlacement[]
  plants          Plant[]
  diaries         Diary[]                    @relation("DiaryCultivationUnits")
  specBlocks      CultivationUnitSpecBlock[]

  @@index([userId])
  @@index([userId, status])
  @@index([primaryLocationId])
}

model CultivationUnitPlacement {
  id                String                       @id @default(cuid())
  locationId        String
  cultivationUnitId String
  role              CultivationUnitPlacementRole @default(member)
  sortOrder         Int                          @default(0)
  createdAt         DateTime                     @default(now())

  location        Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  cultivationUnit CultivationUnit @relation(fields: [cultivationUnitId], references: [id], onDelete: Cascade)

  @@unique([locationId, cultivationUnitId])
  @@index([cultivationUnitId])
}

model CultivationUnitSpecBlock {
  id                String           @id @default(cuid())
  cultivationUnitId String
  position          Int
  kind              LocationSpecKind

  cultivationUnit CultivationUnit                @relation(fields: [cultivationUnitId], references: [id], onDelete: Cascade)
  lighting        CultivationUnitSpecsLighting?
  enclosure       CultivationUnitSpecsEnclosure?
  space           CultivationUnitSpecsSpace?
  area            CultivationUnitSpecsArea?

  @@unique([cultivationUnitId, position])
  @@index([cultivationUnitId])
}

model CultivationUnitSpecsLighting {
  specBlockId     String @id
  vegetationLamps Json?
  bloomLamps      Json?

  specBlock CultivationUnitSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}

model CultivationUnitSpecsEnclosure {
  specBlockId String  @id
  productId   String?
  width       Float?
  height      Float?
  depth       Float?

  specBlock CultivationUnitSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CultivationUnitSpecsSpace {
  specBlockId String @id
  width       Float?
  height      Float?
  depth       Float?

  specBlock CultivationUnitSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}

model CultivationUnitSpecsArea {
  specBlockId String @id
  width       Float?
  depth       Float?

  specBlock CultivationUnitSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}

// --- Public site content (SITE-1) ------------------------------------------

enum CropKind {
  TOMATO
  ZUCCHINI
  EGGPLANT
  CUCUMBER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// SEO guide page for a crop (admin CRUD, public read when PUBLISHED).
model CropGuide {
  id             String        @id @default(cuid())
  cropKind       CropKind
  slug           String        @unique
  title          String
  excerpt        String?
  body           Json          @default("[]")
  bodySiteMd     String        @default("") @db.Text
  bodyTelegramMd String        @default("") @db.Text
  coverMediaId   String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int           @default(0)
  telegramPublishedAt DateTime?
  telegramMessageId   String?
  telegramPostUrl     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  coverMedia     Media?                 @relation("GuideCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  taxonomyLinks  CropGuideTaxonomyTag[]

  @@index([cropKind])
  @@index([status])
  @@index([sortOrder])
}

/// Editable site page (e.g. home landing sections).
model SitePage {
  id             String        @id @default(cuid())
  key            String        @unique
  title          String
  sections       Json          @default("[]")
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}
