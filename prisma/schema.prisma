generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Срез схемы (фиксация после выходных, 2026-04-13)
// - Role: только USER | ADMIN (совпадает с JWT/контрактами; при расхождении с БД — отдельная миграция enum).
// - Location: владелец userId, статусы/типы Strapi-совместимые, specs (блоки lighting,
//   enclosure, space, area), связи Plant.locationId и M2M Diary↔Location.
// - Подробности домена: memory/locations/main.md в корневом репозитории.
// =============================================================================

enum Role {
  USER
  ADMIN
}

enum BrandCategory {
  BREADER
  TENT
  LAMP
  COMMON
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plants    Plant[]
  diaries   Diary[]
  locations Location[]
}

model Plant {
  id         String   @id @default(cuid())
  userId     String
  diaryId    String?
  locationId String?
  name       String
  summarize  String?  @default("")
  current    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diary    Diary?    @relation(fields: [diaryId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([diaryId])
  @@index([locationId])
}

model Event {
  id         String   @id @default(cuid())
  actionPath String
  targetType String
  targetId   String
  payload    Json
  timestamp  DateTime @default(now())
  isSystem   Boolean  @default(false)

  @@index([targetType, targetId, timestamp])
  @@index([actionPath])
}

model Tag {
  id         String   @id @default(cuid())
  label      String   @unique
  targetType String?
  color      String?
  icon       String?
  category   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  actionPathRegistries ActionPathRegistry[]

  @@index([category])
  @@index([targetType])
  @@index([label])
}

model ActionPathRegistry {
  id           String   @id @default(cuid())
  actionPath   String   @unique
  description  String?  @default("")
  targetType   String
  mapping      Json
  conditions   Json?
  autoTagRules Json?
  schema       Json?
  tagId        String?
  groupId      String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tag   Tag?                     @relation(fields: [tagId], references: [id], onDelete: SetNull)
  group ActionPathRegistryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([targetType])
  @@index([tagId])
  @@index([groupId, position])
}

model ActionPathRegistryGroup {
  id          String   @id @default(cuid())
  path        String   @unique
  description String?  @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registries ActionPathRegistry[]

  @@index([path])
}

model Diary {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  body      String
  summarize String?  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plants    Plant[]
  locations Location[] @relation("DiaryLocations")

  @@index([userId])
}

model Media {
  id        String   @id @default(cuid())
  provider  String
  bucket    String
  key       String
  url       String
  mime      String?
  size      Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  brandAvatarFor   Brand?   @relation("BrandAvatar")
  productAvatarFor Product? @relation("ProductAvatar")

  @@index([provider])
  @@index([bucket])
}

model Brand {
  id            String        @id @default(cuid())
  name          String
  category      BrandCategory
  avatarMediaId String?       @unique
  description   String?       @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  avatar   Media?    @relation("BrandAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([category])
  @@index([name])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String
  brandId       String
  avatarMediaId String?  @unique
  summarize     String?  @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand                      Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  avatar                     Media?                   @relation("ProductAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  locationSpecEnclosures LocationSpecsEnclosure[]

  @@index([brandId])
  @@index([category])
  @@index([name])
}

// --- Location (ex Strapi api::location) ------------------------------------

enum LocationStatus {
  active
  archived
}

/// indoor | outdoor | greenhouse — задаёт семейство subType
enum LocationType {
  indoor
  outdoor
  greenhouse
}

/// Бывший Strapi `sub_type`; префикс должен соответствовать `type` (проверка на уровне приложения)
enum LocationSubType {
  indoor_growbox
  indoor_cabinet
  indoor_pc_case
  indoor_shelf
  indoor_room
  outdoor_bed
  outdoor_soil
  outdoor_pot
  greenhouse_classic
  greenhouse_tunnel
}

enum LocationWateringType {
  manual
  drip
  hydroponics
  aeroponics
}

/// Дискриминант для блоков бывшего dynamic zone `specs`
enum LocationSpecKind {
  lighting
  enclosure
  space
  area
}

model Location {
  id            String                @id @default(cuid())
  userId        String
  name          String
  status        LocationStatus        @default(active)
  type          LocationType?
  subType       LocationSubType?
  wateringType  LocationWateringType?
  description   String?
  capacity      Int?
  occupiedSlots Int?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plants     Plant[]
  diaries    Diary[]             @relation("DiaryLocations")
  specBlocks LocationSpecBlock[]

  @@index([userId])
  @@index([userId, status])
}

/// Упорядоченный список блоков specs (аналог Strapi dynamic zone)
model LocationSpecBlock {
  id         String           @id @default(cuid())
  locationId String
  position   Int
  kind       LocationSpecKind

  location  Location                @relation(fields: [locationId], references: [id], onDelete: Cascade)
  lighting  LocationSpecsLighting?
  enclosure LocationSpecsEnclosure?
  space     LocationSpecsSpace?
  area      LocationSpecsArea?

  @@unique([locationId, position])
  @@index([locationId])
}

/// location-specs.lighting — лампы как JSON (массивы IEquipmentLamp-подобных объектов)
model LocationSpecsLighting {
  specBlockId     String @id
  vegetationLamps Json?
  bloomLamps      Json?

  specBlock LocationSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}

/// location-specs.enclosure
model LocationSpecsEnclosure {
  specBlockId String  @id
  productId   String?
  width       Float?
  height      Float?
  depth       Float?

  specBlock LocationSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

/// location-specs.space
model LocationSpecsSpace {
  specBlockId String @id
  width       Float?
  height      Float?
  depth       Float?

  specBlock LocationSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}

/// location-specs.area
model LocationSpecsArea {
  specBlockId String @id
  width       Float?
  depth       Float?

  specBlock LocationSpecBlock @relation(fields: [specBlockId], references: [id], onDelete: Cascade)
}
