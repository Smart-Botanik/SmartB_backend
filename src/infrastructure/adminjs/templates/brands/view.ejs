<% 
layout('layout/admin', {
    title: brand.name,
    activeItem: 'brands',
    currentUser: currentUser,
    additionalHead: `
        <style>
            .brand-header {
                display: flex;
                gap: 24px;
                margin-bottom: 32px;
                align-items: flex-start;
            }
            .brand-avatar {
                width: 120px;
                height: 120px;
                object-fit: cover;
                border-radius: 12px;
                border: 1px solid #e1e8ed;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }
            .brand-avatar-placeholder {
                width: 120px;
                height: 120px;
                background: #e1e8ed;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 48px;
                color: #6c757d;
            }
            .brand-info h1 {
                font-size: 32px;
                font-weight: 700;
                color: #2c3e50;
                margin-bottom: 8px;
            }
            .brand-meta {
                color: #6c757d;
                margin-bottom: 16px;
                line-height: 1.6;
            }
            .brand-description {
                line-height: 1.6;
                color: #495057;
                background: #f8f9fa;
                padding: 20px;
                border-radius: 8px;
                border-left: 4px solid #007bff;
            }
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 20px;
                margin-bottom: 32px;
            }
            .stat-card {
                background: #f8f9fa;
                padding: 24px;
                border-radius: 8px;
                text-align: center;
                border: 1px solid #e1e8ed;
            }
            .stat-number {
                font-size: 32px;
                font-weight: 700;
                color: #007bff;
                margin-bottom: 8px;
            }
            .stat-label {
                color: #6c757d;
                font-size: 14px;
                font-weight: 500;
            }
            .brand-actions {
                display: flex;
                gap: 12px;
                margin-top: 24px;
            }
            .danger-zone {
                margin-top: 32px;
                padding-top: 32px;
                border-top: 1px solid #e1e8ed;
            }
        </style>
    `,
    additionalScripts: `
        <script>
            function confirmDelete() {
                if (confirm('Are you sure you want to delete this brand? This action cannot be undone.')) {
                    fetch('/admin/brands/${brand.id}', { method: 'DELETE' })
                        .then(response => {
                            if (response.ok) {
                                window.location.href = '/admin/brands';
                            } else {
                                alert('Error deleting brand');
                            }
                        });
                }
            }
        </script>
    `
}) 
%>

<div class="card">
    <div class="brand-header">
        <% if (brand.avatar) { %>
            <img src="/uploads/<%= brand.avatar.path %>" class="brand-avatar" alt="<%= brand.name %>">
        <% } else { %>
            <div class="brand-avatar-placeholder">🏷️</div>
        <% } %>
        
        <div class="brand-info" style="flex: 1;">
            <h1><%= brand.name %></h1>
            <div class="brand-meta">
                <% if (brand.category) { %>
                    <strong>Category:</strong> 
                    <span style="background: #e3f2fd; color: #1976d2; padding: 4px 8px; border-radius: 4px; font-size: 12px; margin-left: 8px;">
                        <%= brand.category %>
                    </span>
                    <br>
                <% } %>
                <strong>Created:</strong> <%= new Date(brand.createdAt).toLocaleDateString() %><br>
                <strong>Updated:</strong> <%= new Date(brand.updatedAt).toLocaleDateString() %>
            </div>
            
            <% if (hasPermission(currentUser, "Brand", "update")) { %>
                <div class="brand-actions">
                    <a href="/admin/brands/<%= brand.id %>/edit" class="btn btn-primary">✏️ Edit Brand</a>
                </div>
            <% } %>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number"><%= brand._count?.products || 0 %></div>
            <div class="stat-label">Products</div>
        </div>
    </div>

    <% if (brand.summarize) { %>
        <div class="brand-description">
            <h3 style="margin-bottom: 12px; color: #2c3e50;">About this brand</h3>
            <%= brand.summarize %>
        </div>
    <% } else { %>
        <div class="brand-description">
            <p style="color: #6c757d; font-style: italic;">No description provided for this brand.</p>
        </div>
    <% } %>

    <div style="margin-top: 32px;">
        <a href="/admin/brands" class="btn btn-secondary">← Back to Brands</a>
    </div>

    <% if (hasPermission(currentUser, "Brand", "delete")) { %>
        <div class="danger-zone">
            <h3 style="margin-bottom: 16px; color: #dc3545;">Danger Zone</h3>
            <p style="color: #6c757d; margin-bottom: 16px;">Once you delete a brand, there is no going back. Please be certain.</p>
            <button onclick="confirmDelete()" class="btn btn-danger">🗑️ Delete Brand</button>
        </div>
    <% } %>
</div>
