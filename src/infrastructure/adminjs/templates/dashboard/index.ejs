<% 
layout('layout/admin', {
    title: 'Dashboard',
    activeItem: 'dashboard',
    currentUser: currentUser,
    additionalHead: '',
    additionalScripts: ''
}) 
%>

<div class="card">
    <h1 style="font-size: 32px; font-weight: 700; color: #2c3e50; margin-bottom: 8px;">Dashboard</h1>
    <p style="color: #6c757d; margin-bottom: 32px;">Welcome to the Growing App admin panel</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 32px;">
        <div style="background: #e3f2fd; padding: 24px; border-radius: 8px; text-align: center;">
            <div style="font-size: 36px; font-weight: 700; color: #1976d2; margin-bottom: 8px;"><%= stats.products %></div>
            <div style="color: #1976d2; font-size: 14px; font-weight: 500;">Products</div>
        </div>
        
        <div style="background: #f3e5f5; padding: 24px; border-radius: 8px; text-align: center;">
            <div style="font-size: 36px; font-weight: 700; color: #7b1fa2; margin-bottom: 8px;"><%= stats.brands %></div>
            <div style="color: #7b1fa2; font-size: 14px; font-weight: 500;">Brands</div>
        </div>
        
        <div style="background: #e8f5e8; padding: 24px; border-radius: 8px; text-align: center;">
            <div style="font-size: 36px; font-weight: 700; color: #388e3c; margin-bottom: 8px;"><%= stats.plants %></div>
            <div style="color: #388e3c; font-size: 14px; font-weight: 500;">Plants</div>
        </div>
        
        <div style="background: #fff3e0; padding: 24px; border-radius: 8px; text-align: center;">
            <div style="font-size: 36px; font-weight: 700; color: #f57c00; margin-bottom: 8px;"><%= stats.diaries %></div>
            <div style="color: #f57c00; font-size: 14px; font-weight: 500;">Diaries</div>
        </div>
        
        <div style="background: #fce4ec; padding: 24px; border-radius: 8px; text-align: center;">
            <div style="font-size: 36px; font-weight: 700; color: #c2185b; margin-bottom: 8px;"><%= stats.users %></div>
            <div style="color: #c2185b; font-size: 14px; font-weight: 500;">Users</div>
        </div>
        
        <div style="background: #e0f2f1; padding: 24px; border-radius: 8px; text-align: center;">
            <div style="font-size: 36px; font-weight: 700; color: #00796b; margin-bottom: 8px;"><%= stats.media %></div>
            <div style="color: #00796b; font-size: 14px; font-weight: 500;">Media Files</div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div style="background: #f8f9fa; padding: 24px; border-radius: 8px; border: 1px solid #e1e8ed;">
            <h3 style="margin-bottom: 16px; color: #2c3e50;">Quick Actions</h3>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <% if (hasPermission(currentUser, "Product", "create")) { %>
                    <a href="/admin/products/new" class="btn btn-primary" style="justify-content: flex-start;">➕ Add Product</a>
                <% } %>
                <% if (hasPermission(currentUser, "Brand", "create")) { %>
                    <a href="/admin/brands/new" class="btn btn-primary" style="justify-content: flex-start;">➕ Add Brand</a>
                <% } %>
                <% if (hasPermission(currentUser, "User", "create")) { %>
                    <a href="/admin/users/new" class="btn btn-primary" style="justify-content: flex-start;">➕ Add User</a>
                <% } %>
            </div>
        </div>
        
        <div style="background: #f8f9fa; padding: 24px; border-radius: 8px; border: 1px solid #e1e8ed;">
            <h3 style="margin-bottom: 16px; color: #2c3e50;">System Status</h3>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #6c757d;">Database</span>
                    <span style="color: #28a745; font-weight: 500;">● Connected</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #6c757d;">Storage</span>
                    <span style="color: #28a745; font-weight: 500;">● Available</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #6c757d;">API</span>
                    <span style="color: #28a745; font-weight: 500;">● Running</span>
                </div>
            </div>
        </div>
    </div>
</div>
